[Unit]
Description=Commonwealth Seed Co auto-deploy from GitHub main
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/commonwealth
Environment=HOME=/home/deploy
ExecStart=/home/deploy/commonwealth/deploy/auto-deploy.sh

# Don't fail the timer if a single deploy has a transient error
SuccessExitStatus=0
