<% content_for :page_title do %>
  <%= @event.new_record? ? 'New event' : @event.title %>
<% end %>

<% content_for :page_actions do %>
  <%= link_to '← All events', spree.admin_events_path, class: 'btn btn-light' %>
<% end %>

<%= form_with model: @event,
      url: (@event.persisted? ? spree.admin_event_path(@event) : spree.admin_events_path),
      method: (@event.persisted? ? :patch : :post),
      local: true,
      html: { multipart: true } do |f| %>
  <% if @event.errors.any? %>
    <div class="card mb-6 border-red-200">
      <div class="card-body text-sm text-red-700">
        <%= @event.errors.full_messages.to_sentence %>
      </div>
    </div>
  <% end %>

  <div class="card mb-6">
    <div class="card-header"><h5 class="card-title">Details</h5></div>
    <div class="card-body space-y-4">
      <% if f.respond_to?(:spree_text_field) %>
        <%= f.spree_text_field :title, required: true, autofocus: true %>
        <%= f.spree_text_field :slug %>
        <%= f.spree_text_area :summary, rows: 3 %>
        <%= f.spree_rich_text_area :description if f.respond_to?(:spree_rich_text_area) %>
        <div class="grid gap-4 sm:grid-cols-2">
          <%= f.spree_datetime_field :starts_at, required: true if f.respond_to?(:spree_datetime_field) %>
          <%= f.spree_datetime_field :ends_at if f.respond_to?(:spree_datetime_field) %>
        </div>
        <%= f.spree_text_field :location %>
        <%= f.spree_check_box :published %>
      <% else %>
        <div>
          <label class="block text-xs uppercase text-zinc-500 mb-1">Title</label>
          <%= f.text_field :title, required: true, class: 'form-control', autofocus: true %>
        </div>
        <div>
          <label class="block text-xs uppercase text-zinc-500 mb-1">Slug</label>
          <%= f.text_field :slug, class: 'form-control' %>
        </div>
        <div>
          <label class="block text-xs uppercase text-zinc-500 mb-1">Summary</label>
          <%= f.text_area :summary, rows: 3, class: 'form-control' %>
        </div>
        <div>
          <label class="block text-xs uppercase text-zinc-500 mb-1">Description</label>
          <%= f.rich_text_area :description %>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-xs uppercase text-zinc-500 mb-1">Starts at</label>
            <%= f.datetime_local_field :starts_at, required: true, class: 'form-control' %>
          </div>
          <div>
            <label class="block text-xs uppercase text-zinc-500 mb-1">Ends at</label>
            <%= f.datetime_local_field :ends_at, class: 'form-control' %>
          </div>
        </div>
        <div>
          <label class="block text-xs uppercase text-zinc-500 mb-1">Location</label>
          <%= f.text_field :location, class: 'form-control' %>
        </div>
        <div class="flex items-center gap-2">
          <%= f.check_box :published %>
          <label>Published</label>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card mb-6">
    <div class="card-header"><h5 class="card-title">Featured image</h5></div>
    <div class="card-body">
      <% if f.respond_to?(:spree_file_field) %>
        <%= f.spree_file_field :featured_image, width: 480, height: 320 %>
      <% else %>
        <%= f.file_field :featured_image, direct_upload: true, class: 'form-control' %>
      <% end %>
      <% if @event.featured_image.attached? %>
        <div class="mt-3"><%= image_tag @event.featured_image, class: 'max-h-48 rounded object-cover' %></div>
      <% end %>
    </div>
  </div>

  <div class="card mb-6">
    <div class="card-header"><h5 class="card-title">Gallery images</h5></div>
    <div class="card-body">
      <%= f.file_field :gallery_images, multiple: true, direct_upload: true, class: 'form-control' %>
      <% if @event.gallery_images.attached? %>
        <div class="mt-4 flex flex-wrap gap-3">
          <% @event.gallery_images.each do |img| %>
            <%= image_tag img, class: 'h-24 w-24 rounded object-cover' %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit (@event.new_record? ? 'Create event' : 'Save event'), class: 'btn btn-primary' %>
  </div>
<% end %>
